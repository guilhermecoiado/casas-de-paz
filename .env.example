NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key
# Domínio usado internamente para transformar o @usuario em login (não envia e-mails)
NEXT_PUBLIC_AUTH_EMAIL_DOMAIN=casasdepaz.app

# ---- Notificações push ----
# Gere com: npm run vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:seu-email@exemplo.com
# Supabase → Project Settings → API → service_role (SECRETA, só no servidor)
SUPABASE_SERVICE_ROLE_KEY=
# Qualquer texto aleatório longo; a Vercel usa para chamar o lembrete agendado
CRON_SECRET=
